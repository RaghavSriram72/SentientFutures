# Every setting the API, the pipeline and the admin pages read.
# Copy this to .env and fill in what you need. .env is gitignored; this file isn't,
# so never put a real secret here.
#
# Nothing loads .env on its own. To use it in a terminal:
#     set -a; source .env; set +a
#
# For local development you need none of this: the defaults give you an
# in-memory database, and DEV_LOGIN=1 lets you sign in without Google.

# ---------- Shared by the API and the pipeline ----------

# Which database. mongomock://local is an in-memory one that lives inside a
# single process, so the API and pipeline only share it when the API runs the
# pipeline itself (PIPELINE_RUNNER=local).
# Local MongoDB (docker compose up -d): mongodb://localhost:27017
# Production: the Atlas connection string, mongodb+srv://...
MONGO_URI=mongomock://local

# The database name inside MONGO_URI. Defaults to sentient_futures.
MONGO_DB=sentient_futures

# "production" turns on the safety checks: JWT_SECRET required, DEV_LOGIN
# refused, in-memory database refused. Anything else means development.
# FLASK_ENV=production counts too. The Docker image sets production.
APP_ENV=development

# ---------- The pipeline ----------

# Triage (the Claude call on each paper) is skipped without it; collection
# still runs. With PIPELINE_RUNNER=local the API also reads it, only to tell
# the admin pages whether triage is set up. With PIPELINE_RUNNER=github it's a
# GitHub Actions secret instead. The API can't see that, so the admin pages
# don't say whether triage is on; a run's log does.
ANTHROPIC_API_KEY=

# Optional. Raises the Semantic Scholar rate limit from the shared pool to 1 request a second.
SEMANTIC_SCHOLAR_API_KEY=

# An email or URL sent in the User-Agent header, so arXiv and Semantic Scholar
# can reach us if the pipeline misbehaves. Set it before running against the live APIs.
PIPELINE_CONTACT=

# The content/ folder (milestones.json, sources.json, posts/). Defaults to the
# one in this repo. The pipeline reads the milestones and the sources the site
# already cites; the API reads sources.json for the source catalog and, with an
# in-memory database, fills its milestones and posts from here at start.
CONTENT_DIR=

# ---------- The API ----------

# How "Run now" starts a run: "local" (a background thread in the API) or
# "github" (asks GitHub to start .github/workflows/pipeline.yml).
PIPELINE_RUNNER=local

# Signs the API's own sign-in tokens. Required in production, at least 32
# characters: openssl rand -hex 32
# In development it can stay empty; a random one is made at start, so you
# sign in again after each restart.
JWT_SECRET=

# The Google OAuth client id from Google Cloud (OAuth consent screen, then
# Credentials, then a "Web application" client). Not a secret.
GOOGLE_CLIENT_ID=

# Local only: 1 turns on sign-in by email alone, for people on the team list.
# The API refuses to start with it in production, or when MONGO_URI is
# anything but an in-memory database or a MongoDB on this machine
# (mongodb://localhost or 127.0.0.1), so it can never open the real data.
DEV_LOGIN=0

# Local only: puts these people on the team list of an in-memory database at
# start, as email:Name pairs separated by commas. For a real database use
# flask --app sf_api users add <email> "<name>"
DEV_USERS=raghav@example.com:Raghav

# Sites allowed to call the API from a browser, separated by commas.
# Defaults to http://localhost:3000,http://localhost:4173
# Production: https://<user>.github.io (an origin has no path)
CORS_ORIGINS=http://localhost:3000,http://localhost:4173

# A fine-grained token for this repo only, with the Actions: write permission.
# "Run now" uses it when PIPELINE_RUNNER=github (it starts pipeline.yml), and
# "Publish to site" uses it whenever it's set with a real database (it starts
# deploy-site.yml). Without it, Publish answers with the command that builds
# the site locally instead.
GITHUB_TOKEN=
# owner/name of the repo with the workflows, e.g. RaghavSriram72/SentientFutures
GITHUB_REPO=
# The branch whose workflows run. Defaults to main.
GITHUB_BRANCH=main

# The commit being served, shown by /api/health. DigitalOcean fills it in (.do/app.yaml).
GIT_SHA=

# The port gunicorn listens on in the Docker image. Defaults to 8080.
PORT=8080

# ---------- The admin pages (frontend/) ----------

# Where the admin pages find the API.
NEXT_PUBLIC_API_URL=http://localhost:5050

# The folder the site is built from. Defaults to ../content. Point it at the
# folder python -m sf_shared.export_site writes (.site-data) to see what a
# publish would put on the site.
DATA_DIR=

# ---------- GitHub Actions (repo Settings > Secrets and variables > Actions) ----------
#
# Variable API_URL: the API's address. deploy-site.yml exports the published
# sources, milestones and posts from it before every build. Without it the site
# is built from content/ alone.

# Same value as GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
